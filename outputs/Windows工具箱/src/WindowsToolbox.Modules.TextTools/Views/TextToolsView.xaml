<UserControl x:Class="WindowsToolbox.Modules.TextTools.Views.TextToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760"
             PreviewKeyDown="TextToolsView_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{DynamicResource CardStyle}" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Text Tools" Style="{DynamicResource SectionTitleStyle}"/>
                        <TextBlock Text="离线完成文本转换、清理、编码与统计，输入内容不会保存。"
                                   Style="{DynamicResource SecondaryTextStyle}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="粘贴" Command="{Binding PasteClipboardCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="清空" Command="{Binding ClearCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="12">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{DynamicResource SearchBoxBorderStyle}" Margin="0,0,0,10">
                            <TextBox x:Name="OperationSearchBox" Text="{Binding OperationSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource SearchTextBoxStyle}" ToolTip="搜索操作"/>
                        </Border>
                        <ListBox ItemsSource="{Binding FilteredOperations}" SelectedItem="{Binding SelectedOperation}"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" CornerRadius="7" Background="{DynamicResource InputBackgroundBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource BodyTextStyle}"/>
                                            <TextBlock Text="{Binding Category}" Style="{DynamicResource CaptionTextStyle}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="300"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{DynamicResource CardStyle}" Padding="14">
                        <WrapPanel>
                            <StackPanel Width="180" Margin="0,0,12,0">
                                <TextBlock Text="每行前缀" Style="{DynamicResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,0">
                                <TextBlock Text="每行后缀" Style="{DynamicResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,0" Visibility="{Binding IsFindReplace, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="查找" Style="{DynamicResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,12,0" Visibility="{Binding IsFindReplace, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="替换为" Style="{DynamicResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <CheckBox Content="区分大小写" IsChecked="{Binding MatchCase}" Style="{DynamicResource ModernCheckBoxStyle}" VerticalAlignment="Bottom" Margin="0,0,12,8"
                                      Visibility="{Binding IsFindReplace, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="处理" Command="{Binding ExecuteCommand}" Style="{DynamicResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{DynamicResource CardStyle}" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="输入" Style="{DynamicResource SectionTitleStyle}" Margin="4,0,0,8"/>
                                <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{DynamicResource ModernTextBoxStyle}"
                                         FontFamily="Consolas" SelectionBrush="{DynamicResource AccentBrush}" CaretBrush="{DynamicResource AccentBrush}"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="12">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                                    <TextBlock Text="输出" Style="{DynamicResource SectionTitleStyle}"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="复制" Command="{Binding CopyOutputCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                        <Button Content="替换输入" Command="{Binding ReplaceInputCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                                        <Button Content="交换" Command="{Binding SwapCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBox Text="{Binding OutputText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{DynamicResource ModernTextBoxStyle}"
                                         FontFamily="Consolas" SelectionBrush="{DynamicResource AccentBrush}" CaretBrush="{DynamicResource AccentBrush}"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Style="{DynamicResource CardStyle}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding Status}" Style="{DynamicResource SecondaryTextStyle}"/>
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding InputStatistics, StringFormat=输入：{0.Characters} 字符 / {0.NonWhitespaceCharacters} 非空白 / {0.LineCount} 行 / UTF-8 {0.Utf8Bytes} B}"
                                       Style="{DynamicResource CaptionTextStyle}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding OutputStatistics, StringFormat=输出：{0.Characters} 字符 / {0.LineCount} 行 / UTF-8 {0.Utf8Bytes} B}"
                                       Style="{DynamicResource CaptionTextStyle}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
