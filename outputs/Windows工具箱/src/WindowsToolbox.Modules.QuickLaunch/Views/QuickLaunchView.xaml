<UserControl x:Class="WindowsToolbox.Modules.QuickLaunch.Views.QuickLaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WindowsToolbox.Modules.QuickLaunch.Converters"
             AllowDrop="True"
             PreviewKeyDown="QuickLaunchView_PreviewKeyDown"
             DragOver="QuickLaunchView_DragOver"
             Drop="QuickLaunchView_Drop"
             MinWidth="780">
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NotNullVisibilityConverter" Invert="True"/>
        <DataTemplate x:Key="QuickLaunchCardTemplate">
            <Button Width="220" Height="122" Margin="0,0,12,12" Padding="14"
                    Style="{DynamicResource ToolCardButtonStyle}"
                    Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开" Click="ContextOpen_Click"/>
                        <MenuItem Header="编辑" Click="ContextEdit_Click"/>
                        <MenuItem Header="固定 / 取消固定" Click="ContextPin_Click"/>
                        <MenuItem Header="打开所在位置" Click="ContextLocation_Click"/>
                        <MenuItem Header="复制路径 / URL" Click="ContextCopy_Click"/>
                        <MenuItem Header="上移" Click="ContextMoveUp_Click"/>
                        <MenuItem Header="下移" Click="ContextMoveDown_Click"/>
                        <Separator/>
                        <MenuItem Header="从快捷启动中移除" Click="ContextRemove_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                            <Grid>
                                <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform" Visibility="{Binding Icon, Converter={StaticResource NotNullVisibilityConverter}}"/>
                                <TextBlock Text="{Binding FallbackGlyph}" Style="{DynamicResource FluentIconStyle}" FontSize="18" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding Icon, Converter={StaticResource NullVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding TypeText}" Style="{DynamicResource CaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,8,0,4">
                        <TextBlock Text="{Binding Name}" Style="{DynamicResource CardTitleStyle}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Group}" Style="{DynamicResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Target}" Style="{DynamicResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{DynamicResource CaptionTextStyle}"/>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <Border Style="{DynamicResource CardStyle}" Padding="20">
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="快捷启动" Style="{DynamicResource SectionTitleStyle}"/>
                        <TextBlock Text="Quick Launch" Style="{DynamicResource CaptionTextStyle}" Margin="0,2,0,0"/>
                        <TextBlock Text="快速打开常用应用、文件夹、文件和网页，不扫描全盘。" Style="{DynamicResource SecondaryTextStyle}" Margin="0,7,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="添加应用" Click="AddApplication_Click" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="添加文件夹" Click="AddFolder_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="添加文件" Click="AddFile_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="添加网页" Click="AddUrl_Click" Style="{DynamicResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Padding="12" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{DynamicResource FluentIconStyle}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="6,0,10,0"/>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource SearchTextBoxStyle}" Height="38"
                             ToolTip="搜索名称、目标或分组；Ctrl+F 聚焦，Enter 打开选中项"/>
                </DockPanel>
            </Border>

            <Border x:Name="EditorPanel" Style="{DynamicResource CardStyle}" Padding="16" Margin="0,12,0,0"
                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="类型" Style="{DynamicResource FieldLabelStyle}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ItemTypes}" SelectedItem="{Binding EditingType}" Style="{DynamicResource ModernComboBoxStyle}"/>
                    <TextBlock Grid.Column="2" Text="名称" Style="{DynamicResource FieldLabelStyle}" Margin="20,0,0,7"/>
                    <TextBox Grid.Column="3" Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/>
                    <TextBlock Grid.Row="1" Text="目标" Style="{DynamicResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditingTarget, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/>
                    <TextBlock Grid.Row="2" Text="分组" Style="{DynamicResource FieldLabelStyle}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" ItemsSource="{Binding GroupNames}" Text="{Binding EditingGroup, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernComboBoxStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Arguments" Style="{DynamicResource FieldLabelStyle}" Margin="20,0,0,7"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding EditingArguments, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" ToolTip="仅 Application 使用，不会通过 cmd 或 PowerShell 执行"/>
                    <TextBlock Grid.Row="3" Text="Working Directory" Style="{DynamicResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding EditingWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="取消" Command="{Binding CancelEditCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="保存快捷项" Command="{Binding SaveEditCommand}" Style="{DynamicResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="固定 / Pinned" Style="{DynamicResource SectionTitleStyle}" Margin="0,20,0,10"/>
            <ItemsControl ItemsSource="{Binding PinnedItems}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource QuickLaunchCardTemplate}"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="最近使用 / Recent" Style="{DynamicResource SectionTitleStyle}" Margin="0,18,0,10"/>
            <ItemsControl ItemsSource="{Binding RecentItems}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource QuickLaunchCardTemplate}"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="全部快捷项 / All Items" Style="{DynamicResource SectionTitleStyle}" Margin="0,18,0,10"/>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><ContentControl Content="{Binding}" ContentTemplate="{StaticResource QuickLaunchCardTemplate}"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{DynamicResource EmptyStateCardStyle}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Status}" Style="{DynamicResource SecondaryTextStyle}"/>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,5,0,0"/>
                    <TextBlock Text="支持从资源管理器拖入 EXE、文件夹和文件；右键快捷项可编辑、固定、复制路径或移除记录。" Style="{DynamicResource CaptionTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
