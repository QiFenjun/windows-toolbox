<UserControl x:Class="WindowsToolbox.Modules.ClipboardPlus.Views.ClipboardPlusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WindowsToolbox.Modules.ClipboardPlus.Models"
             MinWidth="720"
             PreviewKeyDown="ClipboardPlusView_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <Border Style="{DynamicResource NotificationCardStyle}"
                    Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{DynamicResource FluentIconStyle}"
                               Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding NotificationMessage}" Style="{DynamicResource BodyTextStyle}"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Padding="20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="剪贴板监听" Style="{DynamicResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryTextStyle}" Margin="0,6,0,0"/>
                        <TextBlock Text="仅记录纯文本，内容保存在当前用户的加密存储中。"
                                   Style="{DynamicResource CaptionTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding IsEnabled, Converter={StaticResource BooleanToEnableTextConverter}}"
                            Command="{Binding EnableCommand}" Style="{DynamicResource SecondaryButtonStyle}"
                            Margin="12,0,8,0"/>
                    <Button Grid.Column="2" Content="{Binding IsPaused, Converter={StaticResource BooleanToPauseTextConverter}}"
                            Command="{Binding PauseCommand}" Style="{DynamicResource PrimaryButtonStyle}"
                            IsEnabled="{Binding IsEnabled}"/>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Padding="14" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{DynamicResource SearchBoxBorderStyle}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" Style="{DynamicResource FluentIconStyle}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource SearchTextBoxStyle}" ToolTip="搜索剪贴板历史"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Text="容量" Style="{DynamicResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding CapacityOptions}" SelectedItem="{Binding Capacity}"
                              Style="{DynamicResource ModernComboBoxStyle}" Width="92" Margin="0,0,12,0"/>
                    <Button Grid.Column="3" Content="清空历史" Command="{Binding ClearCommand}"
                            Style="{DynamicResource DangerOutlineButtonStyle}"/>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="10">
                    <ListBox x:Name="HistoryList" ItemsSource="{Binding VisibleItems}" SelectedItem="{Binding SelectedItem}"
                             MouseDoubleClick="HistoryList_MouseDoubleClick"
                             BorderThickness="0" Background="Transparent" MaxHeight="520"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ClipboardHistoryItem}">
                                <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Preview}" Style="{DynamicResource BodyTextStyle}"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="42"/>
                                            <TextBlock Text="{Binding SourceDisplayName, StringFormat=来源：{0}}" Style="{DynamicResource CaptionTextStyle}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding CapturedAtText}" Style="{DynamicResource CaptionTextStyle}"
                                                   VerticalAlignment="Top" Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="项目详情" Style="{DynamicResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding SelectedItem.Preview}" Style="{DynamicResource BodyTextStyle}"
                                   TextWrapping="Wrap" Margin="0,14,0,12" MaxHeight="220"/>
                        <TextBlock Text="{Binding SelectedItem.CapturedAtText, StringFormat=记录时间：{0}}"
                                   Style="{DynamicResource CaptionTextStyle}"/>
                        <TextBlock Text="{Binding SelectedItem.SourceDisplayName, StringFormat=来源：{0}}"
                                   Style="{DynamicResource CaptionTextStyle}" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="复制" Command="{Binding CopyCommand}" CommandParameter="{Binding SelectedItem}"
                                    Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="置顶/取消" Command="{Binding PinCommand}" CommandParameter="{Binding SelectedItem}"
                                    Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="删除" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem}"
                                    Style="{DynamicResource DangerOutlineButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
