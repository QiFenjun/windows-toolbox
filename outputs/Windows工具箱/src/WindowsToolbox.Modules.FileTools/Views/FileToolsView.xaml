<UserControl x:Class="WindowsToolbox.Modules.FileTools.Views.FileToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True"
             DragOver="FileToolsView_DragOver"
             Drop="FileToolsView_Drop"
             MinWidth="780">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{DynamicResource CardStyle}" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="File Tools" Style="{DynamicResource SectionTitleStyle}"/>
                        <TextBlock Text="本地文件快速处理与检查工作台，不上传文件或 Hash。"
                                   Style="{DynamicResource SecondaryTextStyle}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="选择文件" Click="ChooseFiles_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="选择文件夹" Click="ChooseFolder_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="清空" Click="Clear_Click" Style="{DynamicResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="工具" Style="{DynamicResource FieldLabelStyle}" Margin="4,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RenameTabButton" Content="批量重命名" Click="RenameTab_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="HashTabButton" Content="文件校验" Click="HashTab_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="PathTabButton" Content="路径工具" Click="PathTab_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button x:Name="InfoTabButton" Content="文件信息" Click="InfoTab_Click" Style="{DynamicResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="4" Style="{DynamicResource CardStyle}" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="移除选中" Click="RemoveSelected_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="重新生成预览" Click="RefreshPreview_Click" Style="{DynamicResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedPaths.Count, StringFormat=已选择 {0} 个项目；也可从资源管理器拖放到此处}"
                                   Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                        <ListBox x:Name="SelectionList" ItemsSource="{Binding SelectedPaths}" SelectionMode="Extended"
                                 Height="48" Margin="0,7,0,0" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="6">
                <Grid x:Name="RenamePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{DynamicResource CardStyle}" Padding="14">
                        <WrapPanel>
                            <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="前缀" Style="{DynamicResource FieldLabelStyle}"/><TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/></StackPanel>
                            <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="后缀（扩展名前）" Style="{DynamicResource FieldLabelStyle}"/><TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/></StackPanel>
                            <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="查找" Style="{DynamicResource FieldLabelStyle}"/><TextBox Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/></StackPanel>
                            <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="替换" Style="{DynamicResource FieldLabelStyle}"/><TextBox Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/></StackPanel>
                            <StackPanel Width="135" Margin="0,0,10,0"><TextBlock Text="大小写" Style="{DynamicResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding CaseModes}" SelectedItem="{Binding CaseMode}" Style="{DynamicResource ModernComboBoxStyle}"/></StackPanel>
                            <StackPanel Width="150" Margin="0,0,10,0"><TextBlock Text="新扩展名（可选）" Style="{DynamicResource FieldLabelStyle}"/><TextBox Text="{Binding NewExtension, UpdateSourceTrigger=PropertyChanged}" ToolTip="只修改名称扩展名，不转换文件格式" Style="{DynamicResource ModernTextBoxStyle}"/></StackPanel>
                            <CheckBox Content="启用编号" IsChecked="{Binding NumberingEnabled}" Style="{DynamicResource ModernCheckBoxStyle}" VerticalAlignment="Bottom" Margin="0,0,10,8"/>
                            <StackPanel Width="85" Margin="0,0,10,0"><TextBlock Text="起始" Style="{DynamicResource FieldLabelStyle}"/><TextBox Text="{Binding NumberStart}" Style="{DynamicResource ModernTextBoxStyle}"/></StackPanel>
                            <StackPanel Width="85" Margin="0,0,10,0"><TextBlock Text="步长" Style="{DynamicResource FieldLabelStyle}"/><TextBox Text="{Binding NumberStep}" Style="{DynamicResource ModernTextBoxStyle}"/></StackPanel>
                            <StackPanel Width="85"><TextBlock Text="位数" Style="{DynamicResource FieldLabelStyle}"/><TextBox Text="{Binding NumberDigits}" Style="{DynamicResource ModernTextBoxStyle}"/></StackPanel>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="10">
                        <DataGrid ItemsSource="{Binding RenamePreview}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" HeadersVisibility="Column"
                                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="原名称" Binding="{Binding OriginalName}" Width="2*"/>
                                <DataGridTextColumn Header="新名称" Binding="{Binding NewName}" Width="2*"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100"/>
                                <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="4" Style="{DynamicResource CardStyle}" Padding="12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="撤销上次重命名" Click="UndoRename_Click" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="应用重命名" Click="ApplyRename_Click" Style="{DynamicResource PrimaryButtonStyle}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="先检查预览和冲突，再应用重命名。" Style="{DynamicResource SecondaryTextStyle}"/>
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Status}" Style="{DynamicResource CaptionTextStyle}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid x:Name="HashPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{DynamicResource CardStyle}" Padding="14">
                        <WrapPanel>
                            <StackPanel Width="150" Margin="0,0,12,0"><TextBlock Text="算法" Style="{DynamicResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding HashAlgorithms}" SelectedItem="{Binding SelectedAlgorithm}" Style="{DynamicResource ModernComboBoxStyle}"/></StackPanel>
                            <StackPanel Width="360" Margin="0,0,12,0"><TextBlock Text="Expected Hash（可选）" Style="{DynamicResource FieldLabelStyle}"/><TextBox Text="{Binding ExpectedHash, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/></StackPanel>
                            <Button Content="开始校验" Click="ComputeHash_Click" Style="{DynamicResource PrimaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                            <Button Content="比较" Click="VerifyHash_Click" Style="{DynamicResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                            <Button Content="生成 SHA256SUMS" Click="GenerateSums_Click" Style="{DynamicResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Margin="0,0,8,0"/>
                            <Button Content="取消" Click="Cancel_Click" Style="{DynamicResource SecondaryButtonStyle}" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="10">
                        <DataGrid ItemsSource="{Binding HashResults}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" HeadersVisibility="Column"
                                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="2*"/>
                                <DataGridTextColumn Header="大小" Binding="{Binding Size, StringFormat={}{0:N0} B}" Width="120"/>
                                <DataGridTextColumn Header="算法" Binding="{Binding Algorithm}" Width="100"/>
                                <DataGridTextColumn Header="Hash" Binding="{Binding Hash}" Width="3*"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="4" Style="{DynamicResource CardStyle}" Padding="12">
                        <StackPanel>
                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding OverallProgress}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding HashProgressText}" Style="{DynamicResource SecondaryTextStyle}"/>
                            <TextBlock Text="{Binding VerificationResult}" Style="{DynamicResource AccentLabelStyle}" Margin="0,4,0,0"/>
                            <TextBlock Text="MD5 仅用于兼容性校验，不用于安全验证。" Style="{DynamicResource CaptionTextStyle}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="PathPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{DynamicResource CardStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="输入路径（每行一个；路径可以不存在）" Style="{DynamicResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding PathInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="76" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{DynamicResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="10">
                        <DataGrid ItemsSource="{Binding PathResults}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True" HeadersVisibility="Column"
                                  Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="170"/>
                                <DataGridTextColumn Header="结果" Binding="{Binding Value}" Width="*"/>
                                <DataGridTemplateColumn Header="复制" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="复制" Click="CopyPath_Click" Tag="{Binding Value}" Style="{DynamicResource SecondaryButtonStyle}" Padding="8,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <Grid x:Name="InfoPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{DynamicResource CardStyle}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="名称" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Column="1" Text="{Binding SelectedInfo.Name}" Style="{DynamicResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="1" Text="完整路径" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedInfo.Path}" TextWrapping="Wrap" Style="{DynamicResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="2" Text="类型 / 大小" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedInfo.StatusText}" Style="{DynamicResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="3" Text="创建 / 修改" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedInfo.CreatedTime, StringFormat={}{0:G}}" Style="{DynamicResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="4" Text="属性" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedInfo.Attributes}" Style="{DynamicResource BodyTextStyle}"/>
                            <TextBlock Grid.Column="2" Text="扩展名" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Column="3" Text="{Binding SelectedInfo.Extension}" Style="{DynamicResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="大小" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedInfo.Size, StringFormat={}{0:N0} B}" Style="{DynamicResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="版本" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedInfo.FileVersion}" Style="{DynamicResource BodyTextStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="公司" Style="{DynamicResource FieldLabelStyle}"/><TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SelectedInfo.Company}" Style="{DynamicResource BodyTextStyle}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="计算文件夹大小" Click="CalculateFolderSize_Click" Style="{DynamicResource PrimaryButtonStyle}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding FolderSize.Summary}" Style="{DynamicResource BodyTextStyle}"/>
                                <TextBlock Text="默认不跟随 Junction、Symbolic Link 或其他 Reparse Point。" Style="{DynamicResource CaptionTextStyle}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
