<Application x:Class="WindowsToolbox.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WindowsToolbox.App.Views"
             xmlns:viewModels="clr-namespace:WindowsToolbox.App.ViewModels"
             xmlns:converters="clr-namespace:WindowsToolbox.App.Converters"
             xmlns:clipboardViews="clr-namespace:WindowsToolbox.Modules.ClipboardPlus.Views;assembly=WindowsToolbox.Modules.ClipboardPlus"
             xmlns:clipboardViewModels="clr-namespace:WindowsToolbox.Modules.ClipboardPlus.ViewModels;assembly=WindowsToolbox.Modules.ClipboardPlus">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Strings.zh-CN.xaml"/>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Colors.Light.xaml"/>
                <ResourceDictionary Source="Themes/Motion.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/CardStyles.xaml"/>
                <ResourceDictionary Source="Themes/ButtonStyles.xaml"/>
                <ResourceDictionary Source="Themes/ControlStyles.xaml"/>
                <ResourceDictionary Source="Themes/ScrollBarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <converters:BooleanToSidebarWidthConverter x:Key="BooleanToSidebarWidthConverter"/>
            <converters:IconKeyToGlyphConverter x:Key="IconKeyToGlyphConverter"/>
            <converters:SelectionToBrushConverter x:Key="SelectionToBrushConverter"/>
            <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
            <converters:PositiveNumberToVisibilityConverter x:Key="PositiveNumberToVisibilityConverter"/>
            <converters:BooleanToEnableTextConverter x:Key="BooleanToEnableTextConverter"/>
            <converters:BooleanToPauseTextConverter x:Key="BooleanToPauseTextConverter"/>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
            </Style>
            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                <Setter Property="Padding" Value="10,6"/>
            </Style>

            <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
                <views:HomeView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AboutViewModel}">
                <views:AboutView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type clipboardViewModels:ClipboardPlusViewModel}">
                <clipboardViews:ClipboardPlusView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
