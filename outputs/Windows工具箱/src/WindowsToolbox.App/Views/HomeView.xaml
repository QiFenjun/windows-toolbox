<UserControl x:Class="WindowsToolbox.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <Border Style="{DynamicResource HeroCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="欢迎使用 Windows 工具箱"
                                   Style="{DynamicResource HeroTitleStyle}"/>
                        <TextBlock Text="把常用的系统操作集中到一个安静、可靠的桌面工具中。"
                                   Style="{DynamicResource HeroBodyStyle}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="88" Height="88"
                            CornerRadius="24"
                            Background="{DynamicResource AccentSoftBrush}"
                            Margin="30,0,4,0">
                        <TextBlock Text="&#xE90F;"
                                   Style="{DynamicResource HeroIconStyle}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,24,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="常用工具" Style="{DynamicResource SectionTitleStyle}"/>
                <Border Grid.Column="1"
                        Style="{DynamicResource CountBadgeStyle}">
                    <TextBlock>
                        <Run Text="已安装 "/>
                        <Run Text="{Binding InstalledModuleCount, Mode=OneWay}"/>
                        <Run Text=" 个模块"/>
                    </TextBlock>
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Id}"
                                Style="{DynamicResource ToolCardButtonStyle}"
                                Width="310"
                                MinHeight="162"
                                Margin="0,0,16,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Width="44" Height="44"
                                        CornerRadius="12"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding IconKey, Converter={StaticResource IconKeyToGlyphConverter}}"
                                               Style="{DynamicResource FluentIconStyle}"
                                               FontSize="20"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="0,16,0,16">
                                    <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource CardTitleStyle}"/>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{DynamicResource SecondaryTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,7,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="打开工具" Style="{DynamicResource AccentLabelStyle}"/>
                                    <TextBlock Text="&#xE72A;"
                                               Style="{DynamicResource SmallFluentIconStyle}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="7,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="最近使用"
                       Style="{DynamicResource SectionTitleStyle}"
                       Margin="0,10,0,14"/>

            <Border Style="{DynamicResource EmptyStateCardStyle}"
                    Visibility="{Binding HasRecentModules, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE823;"
                               Style="{DynamicResource FluentIconStyle}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,12,0"/>
                    <TextBlock Text="打开一个工具后，它会出现在这里。"
                               Style="{DynamicResource SecondaryTextStyle}"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding RecentModules}"
                          Visibility="{Binding HasRecentModules, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Id}"
                                Style="{DynamicResource RecentItemButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding IconKey, Converter={StaticResource IconKeyToGlyphConverter}}"
                                           Style="{DynamicResource FluentIconStyle}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource CardTitleStyle}"/>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{DynamicResource CaptionTextStyle}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="&#xE72A;"
                                           Style="{DynamicResource SmallFluentIconStyle}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
