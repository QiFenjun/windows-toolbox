<UserControl x:Class="WindowsToolbox.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="760" HorizontalAlignment="Left">
            <Border Style="{DynamicResource HeroCardStyle}">
                <StackPanel>
                    <Border Width="64" Height="64"
                            CornerRadius="18"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="&#xE90F;"
                                   Style="{DynamicResource LargeFluentIconStyle}"
                                   FontSize="28"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{DynamicResource AppName}"
                               Style="{DynamicResource HeroTitleStyle}"
                               Margin="0,18,0,0"/>
                    <TextBlock Margin="0,8,0,0" Style="{DynamicResource SecondaryTextStyle}">
                        <Run Text="{DynamicResource AboutVersionPrefix}"/>
                        <Run Text="{Binding Version, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding Runtime, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource AboutSecurity}" Style="{DynamicResource SectionTitleStyle}"/>
                    <TextBlock Text="{DynamicResource AboutSecurityDescription}"
                               Style="{DynamicResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="{DynamicResource AboutSignatureNote}"
                               Style="{DynamicResource SecondaryTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource AboutArchitecture}" Style="{DynamicResource SectionTitleStyle}"/>
                    <TextBlock Text="{DynamicResource AboutArchitectureDescription}"
                               Style="{DynamicResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
