<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="AppName">Windows Toolbox</system:String>
    <system:String x:Key="BrandCaption">A lightweight desktop toolkit</system:String>
    <system:String x:Key="HomeTitle">Home</system:String>
    <system:String x:Key="HomeDescription">Your frequently used Windows tools in one place.</system:String>
    <system:String x:Key="SettingsTitle">Settings</system:String>
    <system:String x:Key="SettingsDescription">Choose a theme, startup page, and app preferences.</system:String>
    <system:String x:Key="AboutTitle">About</system:String>
    <system:String x:Key="AboutDescription">Version, security, and privacy information.</system:String>
    <system:String x:Key="SystemToolsCategory">System Tools</system:String>
    <system:String x:Key="ProductivityToolsCategory">Productivity Tools</system:String>
    <system:String x:Key="SearchModulesPlaceholder">Search tools</system:String>
    <system:String x:Key="SearchModulesTooltip">Search modules by name, description, or keyword</system:String>
    <system:String x:Key="LanguageTooltip">Language</system:String>
    <system:String x:Key="SidebarCollapseLabel">Collapse sidebar</system:String>
    <system:String x:Key="ToggleThemeTooltip">Switch between light and dark themes</system:String>
    <system:String x:Key="MinimizeTooltip">Minimize</system:String>
    <system:String x:Key="MaximizeTooltip">Maximize or restore</system:String>
    <system:String x:Key="CloseTooltip">Close</system:String>
    <system:String x:Key="SidebarCollapseTooltip">Collapse or expand the sidebar</system:String>
    <system:String x:Key="HomeHeroTitle">Welcome to Windows Toolbox</system:String>
    <system:String x:Key="HomeHeroBody">Keep useful Windows tools together in a quiet, reliable desktop app.</system:String>
    <system:String x:Key="HomeModulesHeading">Tools</system:String>
    <system:String x:Key="HomeInstalledPrefix">Installed </system:String>
    <system:String x:Key="HomeInstalledSuffix"> modules</system:String>
    <system:String x:Key="OpenTool">Open tool</system:String>
    <system:String x:Key="RecentUsed">Recently used</system:String>
    <system:String x:Key="RecentEmpty">Tools you open will appear here.</system:String>
    <system:String x:Key="SettingsAppearance">Appearance</system:String>
    <system:String x:Key="SettingsAppearanceDescription">Choose the app color theme. System follows the Windows app theme preference.</system:String>
    <system:String x:Key="SettingsThemeMode">Theme</system:String>
    <system:String x:Key="ThemeSystem">System default</system:String>
    <system:String x:Key="ThemeLight">Light</system:String>
    <system:String x:Key="ThemeDark">Dark</system:String>
    <system:String x:Key="SettingsMotion">Motion</system:String>
    <system:String x:Key="MotionFull">Full</system:String>
    <system:String x:Key="MotionReduced">Reduced</system:String>
    <system:String x:Key="MotionOff">Off</system:String>
    <system:String x:Key="SettingsMotionDescription">Full uses all transitions; Reduced shortens them; Off disables nonessential motion.</system:String>
    <system:String x:Key="SettingsStartup">Startup and interaction</system:String>
    <system:String x:Key="SettingsPrivacyNote">These preferences are stored in the current user's AppData folder.</system:String>
    <system:String x:Key="SettingsStartupPage">Open at startup</system:String>
    <system:String x:Key="SettingsConfirmOperations">Confirm shutdown or cancel operations</system:String>
    <system:String x:Key="SettingsRememberSidebar">Remember sidebar width</system:String>
    <system:String x:Key="SettingsClipboard">Clipboard history is off by default. When enabled, only plain text is stored in encrypted local storage.</system:String>
    <system:String x:Key="SettingsClipboardEnabled">Enable Clipboard+ history</system:String>
    <system:String x:Key="SettingsClipboardHotkey">Enable Win+Alt+V global shortcut</system:String>
    <system:String x:Key="SettingsQuickLaunch">Quick Launch</system:String>
    <system:String x:Key="SettingsQuickLaunchHotkey">Enable Win+Alt+Q global shortcut</system:String>
    <system:String x:Key="SettingsNetwork">Network traffic</system:String>
    <system:String x:Key="SettingsNetworkDescription">Advanced live capture requests administrator approval only when started from Network Traffic. Statistics stay local and never inspect payloads.</system:String>
    <system:String x:Key="SettingsNetworkAutoStart">Start when opening Network Traffic</system:String>
    <system:String x:Key="SettingsNetworkContinue">Keep monitoring after closing the window</system:String>
    <system:String x:Key="SettingsNetworkStartup">Start background monitoring with Windows (off by default)</system:String>
    <system:String x:Key="SettingsSave">Save settings</system:String>
    <system:String x:Key="SettingsSaved">Settings saved</system:String>
    <system:String x:Key="SettingsSaveFailed">Could not save settings. Check access to your user folder.</system:String>
    <system:String x:Key="AboutSecurity">Security and privacy</system:String>
    <system:String x:Key="AboutSecurityDescription">This app runs offline and does not collect or upload data. It normally runs as a standard user; Windows may request administrator approval only for an app's own uninstaller or when you explicitly start advanced ETW network capture. Network statistics use local metadata and never read payloads or decrypt HTTPS. Scheduled power actions call the Windows shutdown.exe utility.</system:String>
    <system:String x:Key="AboutSignatureNote">The app is not signed with a commercial code-signing certificate, so SmartScreen may show an unknown publisher notice.</system:String>
    <system:String x:Key="AboutArchitecture">Modular design</system:String>
    <system:String x:Key="AboutArchitectureDescription">The app discovers tools through a module registry. A module implements IToolModule, provides a ViewModel and view, and is registered at startup.</system:String>
    <system:String x:Key="AboutVersionPrefix">Version </system:String>
</ResourceDictionary>
