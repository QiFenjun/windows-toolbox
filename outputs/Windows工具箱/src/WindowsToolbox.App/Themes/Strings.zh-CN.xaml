<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
    <system:String x:Key="AppName">Windows 工具箱</system:String>
    <system:String x:Key="BrandCaption">轻量桌面工具集</system:String>
    <system:String x:Key="HomeTitle">首页</system:String>
    <system:String x:Key="HomeDescription">集中管理常用的 Windows 小工具。</system:String>
    <system:String x:Key="SettingsTitle">设置</system:String>
    <system:String x:Key="SettingsDescription">调整主题、启动页面与操作偏好。</system:String>
    <system:String x:Key="AboutTitle">关于</system:String>
    <system:String x:Key="AboutDescription">查看版本、安全与隐私信息。</system:String>
    <system:String x:Key="SystemToolsCategory">系统工具</system:String>
    <system:String x:Key="ProductivityToolsCategory">效率工具</system:String>
    <system:String x:Key="SearchModulesPlaceholder">搜索工具模块</system:String>
    <system:String x:Key="SearchModulesTooltip">按名称、说明或关键词搜索模块</system:String>
    <system:String x:Key="LanguageTooltip">语言</system:String>
    <system:String x:Key="SidebarCollapseLabel">收起侧边栏</system:String>
    <system:String x:Key="ToggleThemeTooltip">切换浅色/深色主题</system:String>
    <system:String x:Key="MinimizeTooltip">最小化</system:String>
    <system:String x:Key="MaximizeTooltip">最大化/还原</system:String>
    <system:String x:Key="CloseTooltip">关闭</system:String>
    <system:String x:Key="SidebarCollapseTooltip">收起或展开侧边栏</system:String>
    <system:String x:Key="HomeHeroTitle">欢迎使用 Windows 工具箱</system:String>
    <system:String x:Key="HomeHeroBody">把常用的系统操作集中到一个安静、可靠的桌面工具中。</system:String>
    <system:String x:Key="HomeModulesHeading">常用工具</system:String>
    <system:String x:Key="HomeInstalledPrefix">已安装 </system:String>
    <system:String x:Key="HomeInstalledSuffix"> 个模块</system:String>
    <system:String x:Key="OpenTool">打开工具</system:String>
    <system:String x:Key="RecentUsed">最近使用</system:String>
    <system:String x:Key="RecentEmpty">打开一个工具后，它会出现在这里。</system:String>
    <system:String x:Key="SettingsAppearance">外观</system:String>
    <system:String x:Key="SettingsAppearanceDescription">选择应用使用的颜色主题。跟随系统会读取 Windows 的应用主题设置。</system:String>
    <system:String x:Key="SettingsThemeMode">主题模式</system:String>
    <system:String x:Key="ThemeSystem">跟随系统</system:String>
    <system:String x:Key="ThemeLight">浅色模式</system:String>
    <system:String x:Key="ThemeDark">深色模式</system:String>
    <system:String x:Key="SettingsMotion">界面动画</system:String>
    <system:String x:Key="MotionFull">完整</system:String>
    <system:String x:Key="MotionReduced">减少</system:String>
    <system:String x:Key="MotionOff">关闭</system:String>
    <system:String x:Key="SettingsMotionDescription">完整使用全部过渡；减少会缩短动画；关闭会停用非必要动画。</system:String>
    <system:String x:Key="SettingsStartup">启动与交互</system:String>
    <system:String x:Key="SettingsPrivacyNote">这些偏好保存在当前用户的 AppData 目录中。</system:String>
    <system:String x:Key="SettingsStartupPage">启动时打开</system:String>
    <system:String x:Key="SettingsConfirmOperations">执行关机或取消操作前显示确认</system:String>
    <system:String x:Key="SettingsRememberSidebar">记住侧边栏展开状态</system:String>
    <system:String x:Key="SettingsClipboard">剪贴板历史默认关闭；启用后只记录纯文本，并保存在当前用户的加密存储中。</system:String>
    <system:String x:Key="SettingsClipboardEnabled">启用 Clipboard+ 剪贴板监听</system:String>
    <system:String x:Key="SettingsClipboardHotkey">启用 Win+Alt+V 全局快捷键</system:String>
    <system:String x:Key="SettingsQuickLaunch">快捷启动</system:String>
    <system:String x:Key="SettingsQuickLaunchHotkey">启用 Win+Alt+Q 全局快捷键</system:String>
    <system:String x:Key="SettingsNetwork">网络流量监控</system:String>
    <system:String x:Key="SettingsNetworkDescription">高级实时流量采集仅在网络流量页面启动时按需请求管理员权限。统计全部在本机完成，不读取通信正文。</system:String>
    <system:String x:Key="SettingsNetworkAutoStart">进入网络流量页面时自动启动</system:String>
    <system:String x:Key="SettingsNetworkContinue">关闭主窗口后继续后台监控</system:String>
    <system:String x:Key="SettingsNetworkStartup">随 Windows 启动后台监控（默认关闭）</system:String>
    <system:String x:Key="SettingsSave">保存设置</system:String>
    <system:String x:Key="SettingsSaved">设置已保存</system:String>
    <system:String x:Key="SettingsSaveFailed">无法保存设置，请检查用户目录权限。</system:String>
    <system:String x:Key="AboutSecurity">安全与隐私</system:String>
    <system:String x:Key="AboutSecurityDescription">本软件完全离线运行，不收集或上传数据。主程序默认使用普通用户权限；只有软件自身的卸载程序或用户主动启动网络流量高级 ETW 监控时，Windows 才可能显示管理员权限确认。网络流量统计只处理本机网络元数据，不读取通信正文或解密 HTTPS。定时关机功能仅调用 Windows 自带的 shutdown.exe。</system:String>
    <system:String x:Key="AboutSignatureNote">软件未使用商业代码签名证书，因此 Windows Defender SmartScreen 可能显示“未知发布者”提示。</system:String>
    <system:String x:Key="AboutArchitecture">模块化架构</system:String>
    <system:String x:Key="AboutArchitectureDescription">主程序通过模块注册表发现工具。新增模块只需实现 IToolModule、提供 ViewModel 和页面，并在应用启动处注册。</system:String>
    <system:String x:Key="AboutVersionPrefix">版本 </system:String>
</ResourceDictionary>
