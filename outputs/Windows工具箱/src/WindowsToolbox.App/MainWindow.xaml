<Window x:Class="WindowsToolbox.App.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource AppName}"
        Width="1120"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarContainer"
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12,18,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42"
                                CornerRadius="12"
                                Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE90F;"
                                       Style="{DynamicResource LargeFluentIconStyle}"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="SidebarBrandPanel" Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="8,0,0,0"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource AppName}"
                                       Style="{DynamicResource SidebarBrandStyle}"/>
                            <TextBlock Text="{DynamicResource BrandCaption}"
                                       Style="{DynamicResource SidebarCaptionStyle}"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Row="2"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="home"
                            Style="{DynamicResource SidebarNavButtonStyle}"
                            ToolTip="{DynamicResource HomeTitle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE80F;"
                                       Style="{DynamicResource FluentIconStyle}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Border Width="3" Height="20" CornerRadius="2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{DynamicResource HomeTitle}" Style="{DynamicResource NavTextStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Button.Tag>
                            <Binding Path="CurrentPageId"
                                     Converter="{StaticResource StringEqualsConverter}"
                                     ConverterParameter="home"/>
                        </Button.Tag>
                    </Button>

                    <StackPanel Grid.Row="4">
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,8"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock x:Name="SidebarCategoryLabel" Text="{DynamicResource SystemToolsCategory}" Style="{DynamicResource NavCategoryStyle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Modules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{DynamicResource SidebarNavButtonStyle}"
                                            Tag="{Binding IsSelected}"
                                            Margin="0,0,0,4">
                                        <Button.ToolTip><TextBlock Text="{Binding DisplayName}"/></Button.ToolTip>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IconKey, Converter={StaticResource IconKeyToGlyphConverter}}"
                                                       Style="{DynamicResource FluentIconStyle}"
                                                       Foreground="{Binding IsSelected, Converter={StaticResource SelectionToBrushConverter}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Border Width="3" Height="20" CornerRadius="2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource NavTextStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="12,14,0,8"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource ProductivityToolsCategory}" Style="{DynamicResource NavCategoryStyle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding EfficiencyModules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"
                                            Style="{DynamicResource SidebarNavButtonStyle}"
                                            Tag="{Binding IsSelected}"
                                            Margin="0,0,0,4">
                                        <Button.ToolTip><TextBlock Text="{Binding DisplayName}"/></Button.ToolTip>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IconKey, Converter={StaticResource IconKeyToGlyphConverter}}"
                                                       Style="{DynamicResource FluentIconStyle}"
                                                       Foreground="{Binding IsSelected, Converter={StaticResource SelectionToBrushConverter}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Border Width="3" Height="20" CornerRadius="2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentBrush}"
                                                    Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource NavTextStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Row="6">
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="settings"
                                Style="{DynamicResource SidebarNavButtonStyle}"
                                ToolTip="{DynamicResource SettingsTitle}"
                                Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;" Style="{DynamicResource FluentIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}"
                                        Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{DynamicResource SettingsTitle}" Style="{DynamicResource NavTextStyle}"/>
                                </StackPanel>
                            </Grid>
                            <Button.Tag>
                                <Binding Path="CurrentPageId"
                                         Converter="{StaticResource StringEqualsConverter}"
                                         ConverterParameter="settings"/>
                            </Button.Tag>
                        </Button>
                        <Button Command="{Binding NavigateCommand}"
                                CommandParameter="about"
                                Style="{DynamicResource SidebarNavButtonStyle}"
                                ToolTip="{DynamicResource AboutTitle}"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;" Style="{DynamicResource FluentIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource AccentBrush}"
                                        Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{DynamicResource AboutTitle}" Style="{DynamicResource NavTextStyle}"/>
                                </StackPanel>
                            </Grid>
                            <Button.Tag>
                                <Binding Path="CurrentPageId"
                                         Converter="{StaticResource StringEqualsConverter}"
                                         ConverterParameter="about"/>
                            </Button.Tag>
                        </Button>
                        <Button Command="{Binding ToggleSidebarCommand}"
                                Style="{DynamicResource SidebarNavButtonStyle}"
                                ToolTip="{DynamicResource SidebarCollapseTooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE700;" Style="{DynamicResource FluentIconStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{DynamicResource SidebarCollapseLabel}" Style="{DynamicResource NavTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="82"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource TopbarBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="270"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="138"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="PageHeaderPanel" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTitle}"
                                       Style="{DynamicResource PageTitleStyle}"/>
                            <TextBlock Text="{Binding CurrentDescription}"
                                       Style="{DynamicResource SecondaryTextStyle}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Border Style="{DynamicResource SearchBoxBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;"
                                               Style="{DynamicResource FluentIconStyle}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource SearchModulesTooltip}"
                                             Style="{DynamicResource SearchTextBoxStyle}"
                                             />
                                    <TextBlock Grid.Column="1"
                                               Text="{DynamicResource SearchModulesPlaceholder}"
                                               Margin="2,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SearchText.Length}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2"
                                            Command="{Binding ClearSearchCommand}"
                                            Style="{DynamicResource InlineIconButtonStyle}"
                                            Visibility="{Binding SearchText.Length, Converter={StaticResource PositiveNumberToVisibilityConverter}}">
                                        <TextBlock Text="&#xE711;" Style="{DynamicResource SmallFluentIconStyle}"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{Binding IsSearchOpen, Mode=OneWay}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                   StaysOpen="False"
                                   AllowsTransparency="True">
                                <Border Width="270"
                                        MaxHeight="280"
                                        Style="{DynamicResource SearchPopupStyle}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SearchResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.NavigateCommand, Source={x:Reference RootWindow}}"
                                                            CommandParameter="{Binding Id}"
                                                            Style="{DynamicResource SearchResultButtonStyle}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding IconKey, Converter={StaticResource IconKeyToGlyphConverter}}"
                                                                       Style="{DynamicResource FluentIconStyle}"
                                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource CardTitleStyle}"/>
                                                <TextBlock Text="{Binding Description}"
                                                                           Style="{DynamicResource CaptionTextStyle}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button x:Name="LanguageButton"
                                Grid.Column="3"
                                Click="OpenLanguageMenu"
                                Style="{DynamicResource TopbarIconButtonStyle}"
                                ToolTip="{Binding LanguageToolTip}">
                            <TextBlock Text="{Binding LanguageBadge}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="LanguageMenu"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Placement="Bottom">
                                    <MenuItem Header="{Binding ChineseLanguageMenuLabel}"
                                              Command="{Binding SetLanguageCommand}"
                                              CommandParameter="zh-CN"/>
                                    <MenuItem Header="{Binding EnglishLanguageMenuLabel}"
                                              Command="{Binding SetLanguageCommand}"
                                              CommandParameter="en-US"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Grid.Column="5"
                                Command="{Binding ToggleThemeCommand}"
                                Style="{DynamicResource TopbarIconButtonStyle}"
                                ToolTip="{DynamicResource ToggleThemeTooltip}">
                            <TextBlock Text="&#xE706;" Style="{DynamicResource FluentIconStyle}"/>
                        </Button>

                        <StackPanel Grid.Column="7" Orientation="Horizontal">
                            <Button Style="{DynamicResource WindowControlButtonStyle}"
                                    Click="MinimizeButton_Click"
                                    ToolTip="{DynamicResource MinimizeTooltip}">
                                <TextBlock Text="&#xE921;" Style="{DynamicResource SmallFluentIconStyle}"/>
                            </Button>
                            <Button Style="{DynamicResource WindowControlButtonStyle}"
                                    Click="MaximizeButton_Click"
                                    ToolTip="{DynamicResource MaximizeTooltip}">
                                <TextBlock Text="&#xE922;" Style="{DynamicResource SmallFluentIconStyle}"/>
                            </Button>
                            <Button Style="{DynamicResource CloseWindowButtonStyle}"
                                    Click="CloseButton_Click"
                                    ToolTip="{DynamicResource CloseTooltip}">
                                <TextBlock Text="&#xE8BB;" Style="{DynamicResource SmallFluentIconStyle}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl x:Name="MainContentHost"
                                Grid.Row="1"
                                Content="{Binding CurrentContent}"
                                Focusable="False"
                                RenderTransformOrigin="0.5,0"
                                SnapsToDevicePixels="True">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="MainContentTransform" X="0" Y="0"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Grid>
            <Border x:Name="ThemeTransitionOverlay"
                    Panel.ZIndex="100"
                    Background="{DynamicResource AppBackgroundBrush}"
                    Opacity="0"
                    IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
