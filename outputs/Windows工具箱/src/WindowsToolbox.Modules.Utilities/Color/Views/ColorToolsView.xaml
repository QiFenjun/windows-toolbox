<UserControl x:Class="WindowsToolbox.Modules.Utilities.Color.Views.ColorToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="500">
    <UserControl.Resources>
        <DrawingBrush x:Key="TransparencyCheckerboardBrush"
                      TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H16 V16 H0 Z"/>
                    <GeometryDrawing Brush="#FFD8DDE5" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="颜色工具 / Color Tools" Style="{DynamicResource SectionTitleStyle}"/>
                    <TextBlock Text="离线转换与屏幕取色；颜色历史仅保留在当前应用会话。"
                               Style="{DynamicResource SecondaryTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding StartPickerCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="屏幕取色" Foreground="White"/>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" MinWidth="240"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="0.92*" MinWidth="220"/>
                </Grid.ColumnDefinitions>

                <Border Style="{DynamicResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="颜色值" Style="{DynamicResource CardTitleStyle}"/>
                        <TextBlock Text="HEX" Style="{DynamicResource FieldLabelStyle}" Margin="0,14,0,5"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="复制" Command="{Binding CopyHexCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" Padding="12,7" MinHeight="36" Margin="8,0,0,0"/>
                            <TextBox Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBoxStyle}" MinHeight="36"
                                     SelectionBrush="{DynamicResource AccentBrush}" CaretBrush="{DynamicResource AccentBrush}"/>
                        </DockPanel>

                        <TextBlock Text="RGB" Style="{DynamicResource FieldLabelStyle}" Margin="0,14,0,5"/>
                        <UniformGrid Columns="3" Rows="2">
                            <TextBlock Text="R" Style="{DynamicResource CaptionTextStyle}" Margin="0,0,5,3"/>
                            <TextBlock Text="G" Style="{DynamicResource CaptionTextStyle}" Margin="2,0,3,3"/>
                            <TextBlock Text="B" Style="{DynamicResource CaptionTextStyle}" Margin="4,0,0,3"/>
                            <TextBox Text="{Binding RedText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Red 0–255"
                                     Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding GreenText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Green 0–255"
                                     Style="{DynamicResource ModernTextBoxStyle}" Margin="2,0,3,0"/>
                            <TextBox Text="{Binding BlueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Blue 0–255"
                                     Style="{DynamicResource ModernTextBoxStyle}" Margin="4,0,0,0"/>
                        </UniformGrid>

                        <TextBlock Text="HSL" Style="{DynamicResource FieldLabelStyle}" Margin="0,14,0,5"/>
                        <UniformGrid Columns="3" Rows="2">
                            <TextBlock Text="H" Style="{DynamicResource CaptionTextStyle}" Margin="0,0,5,3"/>
                            <TextBlock Text="S %" Style="{DynamicResource CaptionTextStyle}" Margin="2,0,3,3"/>
                            <TextBlock Text="L %" Style="{DynamicResource CaptionTextStyle}" Margin="4,0,0,3"/>
                            <TextBox Text="{Binding HueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hue 0–360°"
                                     Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding SaturationText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Saturation 0–100%"
                                     Style="{DynamicResource ModernTextBoxStyle}" Margin="2,0,3,0"/>
                            <TextBox Text="{Binding LightnessText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Lightness 0–100%"
                                     Style="{DynamicResource ModernTextBoxStyle}" Margin="4,0,0,0"/>
                        </UniformGrid>

                        <DockPanel Margin="0,14,0,0" LastChildFill="False">
                            <TextBlock Text="Alpha" Style="{DynamicResource FieldLabelStyle}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AlphaLabel}" Style="{DynamicResource CaptionTextStyle}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="10"
                                Value="{Binding AlphaPercent, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Alpha 透明度" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="颜色预览" Style="{DynamicResource CardTitleStyle}"/>
                        <Border Height="132" Margin="0,12,0,12" CornerRadius="8" ClipToBounds="True"
                                Background="{StaticResource TransparencyCheckerboardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Rectangle Fill="{Binding PreviewBrush}"/>
                        </Border>

                        <DockPanel Margin="0,2,0,0" LastChildFill="False">
                            <TextBlock Text="{Binding HexText}" Style="{DynamicResource FieldLabelStyle}"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="HEX" Style="{DynamicResource CaptionTextStyle}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,9,0,0" LastChildFill="False">
                            <TextBlock Text="{Binding RgbDisplay}" Style="{DynamicResource SecondaryTextStyle}"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="复制 RGB" Command="{Binding CopyRgbCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" Padding="10,5" MinHeight="32" Margin="8,0,0,0"/>
                        </DockPanel>
                        <DockPanel Margin="0,5,0,0" LastChildFill="False">
                            <TextBlock Text="{Binding HslDisplay}" Style="{DynamicResource SecondaryTextStyle}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button DockPanel.Dock="Right" Content="复制 HSL" Command="{Binding CopyHslCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" Padding="10,5" MinHeight="32" Margin="8,0,0,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Style="{DynamicResource CardStyle}" Padding="16">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="最近颜色" Style="{DynamicResource CardTitleStyle}"/>
                        <TextBlock DockPanel.Dock="Right" Text="当前会话 · 最多 10 个" Style="{DynamicResource CaptionTextStyle}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RecentColors}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}"
                                        Width="36" Height="36" MinHeight="0" Padding="3" Margin="0,0,8,8"
                                        Style="{DynamicResource SecondaryButtonStyle}">
                                    <Border Width="28" Height="28" Background="{StaticResource TransparencyCheckerboardBrush}" CornerRadius="3">
                                        <Border Background="{Binding Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3"/>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="6" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Grid.Row="6" Text="{Binding Status}" Style="{DynamicResource CaptionTextStyle}"
                       HorizontalAlignment="Right" TextWrapping="Wrap"/>
        </Grid>
    </ScrollViewer>
</UserControl>
