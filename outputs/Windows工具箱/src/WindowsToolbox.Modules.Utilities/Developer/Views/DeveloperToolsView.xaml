<UserControl x:Class="WindowsToolbox.Modules.Utilities.Developer.Views.DeveloperToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="开发者工具 / Developer Tools" Style="{DynamicResource SectionTitleStyle}"/>
            <TextBlock Text="进制转换、UTF-8 文本 Hash 与 UUID 检查；全部本地计算，输入与结果不写入文件、不联网。文件 Hash 请使用文件工具 / File Tools。"
                       Style="{DynamicResource SecondaryTextStyle}" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding CopyStatus}" Style="{DynamicResource CaptionTextStyle}" Margin="0,0,0,8"/>

            <TabControl SelectedIndex="{Binding SelectedTabIndex}">
                <!-- Base Converter -->
                <TabItem Header="进制转换">
                    <Border Style="{DynamicResource CardStyle}" Padding="16" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="二进制、八进制、十进制与十六进制任意精度整数转换"
                                       Style="{DynamicResource CardTitleStyle}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="输入" Style="{DynamicResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding BaseInputText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{DynamicResource ModernTextBoxStyle}"
                                             ToolTip="例如 101010、52、42、2A；可带匹配的 0b / 0o / 0x 前缀"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Source Base" Style="{DynamicResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding SourceBases}"
                                              SelectedIndex="{Binding SelectedSourceBaseIndex}"
                                              Style="{DynamicResource ModernComboBoxStyle}" Width="170"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="显示前缀（0b / 0o / 0x）" IsChecked="{Binding ShowPrefix}"
                                      Style="{DynamicResource ModernCheckBoxStyle}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding BaseError}" Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="BIN:" Style="{DynamicResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BinaryOutput}" Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Button DockPanel.Dock="Right" Content="复制" Command="{Binding CopyBaseCommand}"
                                            CommandParameter="{Binding BinaryOutput}" Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,3" MinHeight="28" Margin="8,0,0,0"/>
                                </DockPanel>
                                <DockPanel Grid.Column="2" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="OCT:" Style="{DynamicResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OctalOutput}" Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Button DockPanel.Dock="Right" Content="复制" Command="{Binding CopyBaseCommand}"
                                            CommandParameter="{Binding OctalOutput}" Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,3" MinHeight="28" Margin="8,0,0,0"/>
                                </DockPanel>
                                <DockPanel Grid.Row="2" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="DEC:" Style="{DynamicResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DecimalOutput}" Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Button DockPanel.Dock="Right" Content="复制" Command="{Binding CopyBaseCommand}"
                                            CommandParameter="{Binding DecimalOutput}" Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,3" MinHeight="28" Margin="8,0,0,0"/>
                                </DockPanel>
                                <DockPanel Grid.Row="2" Grid.Column="2" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="HEX:" Style="{DynamicResource FieldLabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding HexOutput}" Style="{DynamicResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Button DockPanel.Dock="Right" Content="复制" Command="{Binding CopyBaseCommand}"
                                            CommandParameter="{Binding HexOutput}" Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,3" MinHeight="28" Margin="8,0,0,0"/>
                                </DockPanel>
                            </Grid>
                            <TextBlock Text="最多 4096 个字符；负号按数学负数显示（非补码）。"
                                       Style="{DynamicResource CaptionTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- Text Hash -->
                <TabItem Header="文本哈希">
                    <Border Style="{DynamicResource CardStyle}" Padding="16" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="UTF-8 文本 MD5 / SHA-1 / SHA-256 / SHA-512" Style="{DynamicResource CardTitleStyle}"/>
                            <TextBlock Text="输入文本" Style="{DynamicResource FieldLabelStyle}" Margin="0,12,0,5"/>
                            <TextBox Text="{Binding HashInputText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBoxStyle}" AcceptsReturn="True"
                                     MinHeight="90" MaxHeight="220" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="输入仅保留在当前会话，不写入磁盘、不记日志、不上传"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="算法" Style="{DynamicResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding AlgorithmLabels}"
                                              SelectedIndex="{Binding SelectedAlgorithmIndex}"
                                              Style="{DynamicResource ModernComboBoxStyle}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="计算 Hash"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding ComputeHashCommand}"
                                        Style="{DynamicResource PrimaryButtonStyle}"/>
                            </Grid>
                            <TextBlock Text="{Binding AlgorithmNoteText}" Style="{DynamicResource CaptionTextStyle}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HashError}" Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="复制 Hash" Command="{Binding CopyHashCommand}"
                                            CommandParameter="{Binding HashOutput}" Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,3" MinHeight="28" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding HashOutput}" Style="{DynamicResource SecondaryTextStyle}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{Binding HashStatus}" Style="{DynamicResource CaptionTextStyle}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- UUID Inspector -->
                <TabItem Header="UUID 检查">
                    <Border Style="{DynamicResource CardStyle}" Padding="16" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="UUID / GUID 验证、标准化与版本检查（不生成 UUID，生成请用随机工具）"
                                       Style="{DynamicResource CardTitleStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="UUID 输入" Style="{DynamicResource FieldLabelStyle}" Margin="0,12,0,5"/>
                            <TextBox Text="{Binding UuidInputText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     ToolTip="支持带连字符、紧凑格式与花括号格式；输入不保存"/>
                            <TextBlock Text="{Binding UuidError}" Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{Binding UuidValidityText}" Style="{DynamicResource CardTitleStyle}"/>
                                <TextBlock Text="{Binding UuidSpecial}" Style="{DynamicResource SecondaryTextStyle}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>

                                <TextBlock Text="Canonical D" Style="{DynamicResource FieldLabelStyle}" Margin="0,12,0,4"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Copy D" Command="{Binding CopyUuidCommand}"
                                            CommandParameter="{Binding UuidCanonicalD}" Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,3" MinHeight="28" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding UuidCanonicalD}" Style="{DynamicResource SecondaryTextStyle}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Canonical N" Style="{DynamicResource FieldLabelStyle}" Margin="0,10,0,4"/>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Copy N" Command="{Binding CopyUuidCommand}"
                                            CommandParameter="{Binding UuidCanonicalN}" Style="{DynamicResource SecondaryButtonStyle}"
                                            Padding="8,3" MinHeight="28" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding UuidCanonicalN}" Style="{DynamicResource SecondaryTextStyle}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>

                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding UuidVersion, StringFormat=Version：{0}}" Style="{DynamicResource FieldLabelStyle}"/>
                                    <TextBlock Text="{Binding UuidVariant, StringFormat=Variant：{0}}" Style="{DynamicResource FieldLabelStyle}" TextWrapping="Wrap"/>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
