<UserControl x:Class="WindowsToolbox.Modules.Utilities.Unit.Views.UnitConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WindowsToolbox.Modules.Utilities.Unit.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="单位转换 / Unit Converter" Style="{DynamicResource SectionTitleStyle}"/>
            <TextBlock Text="完全离线的常用物理量换算；输入与结果仅保留在当前会话，不写入文件、不联网。"
                       Style="{DynamicResource SecondaryTextStyle}" Margin="0,4,0,12" TextWrapping="Wrap"/>

            <Border Style="{DynamicResource CardStyle}" Padding="16" MaxWidth="620" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="类别 / Category" Style="{DynamicResource FieldLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding CategoryLabels}"
                              SelectedIndex="{Binding SelectedCategoryIndex}"
                              Style="{DynamicResource ModernComboBoxStyle}" Margin="0,5,0,0"/>

                    <TextBlock Text="输入值" Style="{DynamicResource FieldLabelStyle}" Margin="0,14,0,5"/>
                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource ModernTextBoxStyle}"
                             ToolTip="支持整数、小数、负数与科学计数法（例如 1e-6）"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="从 / From" Style="{DynamicResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding FromUnits}"
                                      SelectedItem="{Binding SelectedFromUnit}"
                                      DisplayMemberPath="DisplayLabel"
                                      Style="{DynamicResource ModernComboBoxStyle}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="⇄" ToolTip="交换单位（输入值保持不变）"
                                Command="{Binding SwapCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                VerticalAlignment="Bottom" Padding="14,7" MinHeight="34"/>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="到 / To" Style="{DynamicResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ToUnits}"
                                      SelectedItem="{Binding SelectedToUnit}"
                                      DisplayMemberPath="DisplayLabel"
                                      Style="{DynamicResource ModernComboBoxStyle}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="结果" Style="{DynamicResource FieldLabelStyle}" Margin="0,14,0,5"/>
                    <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="14,12">
                        <TextBlock Text="{Binding ResultText}" Style="{DynamicResource CardTitleStyle}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="复制数值" ToolTip="仅复制结果数值"
                                Command="{Binding CopyValueCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="复制数值与单位" ToolTip="复制结果数值和目标单位符号"
                                Command="{Binding CopyWithUnitCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CopyStatus}" Style="{DynamicResource CaptionTextStyle}"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
