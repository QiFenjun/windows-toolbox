<UserControl x:Class="WindowsToolbox.Modules.Utilities.Views.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WindowsToolbox.Modules.Utilities.Models">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Button Command="{Binding SelectToolCommand}"
                    CommandParameter="qr"
                    Tag="{Binding SelectedToolId, Converter={StaticResource StringEqualsConverter}, ConverterParameter=qr}"
                    Style="{DynamicResource SidebarNavButtonStyle}"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="二维码工具" Style="{DynamicResource NavTextStyle}"/>
                    <TextBlock Text="QR Tools" Style="{DynamicResource NavSecondaryTextStyle}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SelectToolCommand}"
                    CommandParameter="color"
                    Tag="{Binding SelectedToolId, Converter={StaticResource StringEqualsConverter}, ConverterParameter=color}"
                    Style="{DynamicResource SidebarNavButtonStyle}"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="颜色工具" Style="{DynamicResource NavTextStyle}"/>
                    <TextBlock Text="Color Tools" Style="{DynamicResource NavSecondaryTextStyle}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SelectToolCommand}"
                    CommandParameter="time-tools"
                    Tag="{Binding SelectedToolId, Converter={StaticResource StringEqualsConverter}, ConverterParameter=time-tools}"
                    Style="{DynamicResource SidebarNavButtonStyle}"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="时间工具" Style="{DynamicResource NavTextStyle}"/>
                    <TextBlock Text="Time Tools" Style="{DynamicResource NavSecondaryTextStyle}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SelectToolCommand}"
                    CommandParameter="random-tools"
                    Tag="{Binding SelectedToolId, Converter={StaticResource StringEqualsConverter}, ConverterParameter=random-tools}"
                    Style="{DynamicResource SidebarNavButtonStyle}"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="随机工具" Style="{DynamicResource NavTextStyle}"/>
                    <TextBlock Text="Random Tools" Style="{DynamicResource NavSecondaryTextStyle}"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <Border Grid.Column="2"
                >
            <ContentControl Content="{Binding SelectedToolContent}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type models:UtilityToolDescriptor}">
                        <Border Style="{DynamicResource CardStyle}" Padding="24">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ChineseName}" Style="{DynamicResource CardTitleStyle}"/>
                                <TextBlock Text="{Binding EnglishName}" Style="{DynamicResource CaptionTextStyle}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Description}" Style="{DynamicResource SecondaryTextStyle}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
