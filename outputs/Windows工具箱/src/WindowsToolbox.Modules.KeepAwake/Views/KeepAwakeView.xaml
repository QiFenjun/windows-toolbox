<UserControl x:Class="WindowsToolbox.Modules.KeepAwake.Views.KeepAwakeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WindowsToolbox.Modules.KeepAwake.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="840" HorizontalAlignment="Left">
            <Border Style="{DynamicResource CardStyle}" Padding="24">
                <StackPanel>
                    <TextBlock Text="保持唤醒 / Keep Awake" Style="{DynamicResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding Status}" Style="{DynamicResource CardTitleStyle}" TextWrapping="Wrap" Margin="0,20,0,20" AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel IsEnabled="{Binding CanConfigure}">
                        <TextBlock Text="模式 / Mode" Style="{DynamicResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding SelectedMode}" Style="{DynamicResource ModernComboBoxStyle}" AutomationProperties.Name="Awake mode" Margin="0,8,0,20"/>
                        <TextBlock Text="持续时间 / Duration" Style="{DynamicResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Durations}" SelectedItem="{Binding SelectedDuration}" DisplayMemberPath="Label" Style="{DynamicResource ModernComboBoxStyle}" AutomationProperties.Name="Duration" Margin="0,8,0,20"/>
                    </StackPanel>
                    <TextBlock Text="剩余 / Remaining" Style="{DynamicResource FieldLabelStyle}"/>
                    <TextBlock Text="{Binding RemainingText}" FontSize="28" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,6,0,8"/>
                    <TextBlock Text="{Binding TimingText}" Style="{DynamicResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <WrapPanel>
                        <Button Content="开始保持唤醒 / Start" Command="{Binding StartCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,12,8"/>
                        <Button Content="停止 / Stop" Command="{Binding StopCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource CardStyle}" Padding="20" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Static vm:KeepAwakeViewModel.Boundaries}" Style="{DynamicResource CaptionTextStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="每次启动默认关闭，需手动开启。电池供电时会增加耗电。 / Starts inactive; enable manually. Increases battery usage." Style="{DynamicResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
