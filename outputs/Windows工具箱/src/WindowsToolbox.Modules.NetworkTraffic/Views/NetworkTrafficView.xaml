<UserControl x:Class="WindowsToolbox.Modules.NetworkTraffic.Views.NetworkTrafficView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Style="{DynamicResource NotificationCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE774;" Style="{DynamicResource FluentIconStyle}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding MonitoringStateText}" Style="{DynamicResource CardTitleStyle}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{DynamicResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{DynamicResource CardStyle}">
                    <StackPanel><TextBlock Text="下载速度" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Text="{Binding TotalDownloadRateText}" Style="{DynamicResource PageTitleStyle}" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                    <StackPanel><TextBlock Text="上传速度" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Text="{Binding TotalUploadRateText}" Style="{DynamicResource PageTitleStyle}" Margin="0,5,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{DynamicResource CardStyle}">
                    <StackPanel><TextBlock Text="活跃应用" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Text="{Binding ActiveApplicationCount}" Style="{DynamicResource PageTitleStyle}" Margin="0,5,0,0"/></StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="最近 60 秒" Style="{DynamicResource SectionTitleStyle}"/>
                        <Canvas Width="560" Height="70" Margin="0,10,0,0" ClipToBounds="True">
                            <Line X1="0" X2="560" Y1="62" Y2="62" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1"/>
                            <Polyline Points="{Binding DownloadPoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                            <Polyline Points="{Binding UploadPoints}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2"/>
                        </Canvas>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="下载" Foreground="{DynamicResource AccentBrush}" Style="{DynamicResource CaptionTextStyle}"/>
                            <TextBlock Text="上传" Foreground="{DynamicResource SuccessBrush}" Style="{DynamicResource CaptionTextStyle}" Margin="14,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="开始监控" Command="{Binding StartCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,0,8"/>
                        <Button Content="停止监控" Command="{Binding StopCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,0,8"/>
                        <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <Border Style="{DynamicResource CardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <WrapPanel>
                            <Border Style="{DynamicResource SearchBoxBorderStyle}" Width="210" Margin="0,0,8,6">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource SearchTextBoxStyle}" ToolTip="搜索应用名称或公司"/>
                            </Border>
                            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Style="{DynamicResource ModernComboBoxStyle}" Width="112" Margin="0,0,8,6"/>
                            <ComboBox ItemsSource="{Binding SortModes}" SelectedItem="{Binding SelectedSortMode}" Style="{DynamicResource ModernComboBoxStyle}" Width="138" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <ListBox Grid.Row="2" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="9" Padding="12"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="102"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" VerticalAlignment="Top"><TextBlock Text="&#xE774;" Style="{DynamicResource FluentIconStyle}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0"><TextBlock Text="{Binding DisplayName}" Style="{DynamicResource CardTitleStyle}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PathText}" Style="{DynamicResource CaptionTextStyle}" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding DownloadRateText, StringFormat=↓ {0}}" Style="{DynamicResource BodyTextStyle}"/><TextBlock Text="{Binding UploadRateText, StringFormat=↑ {0}}" Style="{DynamicResource CaptionTextStyle}" Margin="0,4,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Text="{Binding SessionTotalText, StringFormat=本次 {0}}" Style="{DynamicResource BodyTextStyle}"/><TextBlock Text="{Binding ConnectionCount, StringFormat={}{0} 连接}" Style="{DynamicResource CaptionTextStyle}" Margin="0,4,0,0"/></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="应用详情" Style="{DynamicResource SectionTitleStyle}"/>
                            <TextBlock Text="{Binding SelectedApplication.DisplayName}" Style="{DynamicResource CardTitleStyle}" TextWrapping="Wrap" Margin="0,12,0,4"/>
                            <TextBlock Text="{Binding SelectedApplication.PathText, StringFormat=网络路径：{0}}" Style="{DynamicResource SecondaryTextStyle}"/>
                            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="98"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="本次下载" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Grid.Column="1" Text="{Binding SelectedApplication.SessionDownloadBytes, StringFormat={}{0:N0} B}" Style="{DynamicResource BodyTextStyle}"/><TextBlock Grid.Row="1" Text="本次上传" Style="{DynamicResource CaptionTextStyle}" Margin="0,6,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedApplication.SessionUploadBytes, StringFormat={}{0:N0} B}" Style="{DynamicResource BodyTextStyle}" Margin="0,6,0,0"/><TextBlock Grid.Row="2" Text="今天" Style="{DynamicResource CaptionTextStyle}" Margin="0,6,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedApplication.TodayTotalText}" Style="{DynamicResource BodyTextStyle}" Margin="0,6,0,0"/><TextBlock Grid.Row="3" Text="进程" Style="{DynamicResource CaptionTextStyle}" Margin="0,6,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedApplication.ProcessCount}" Style="{DynamicResource BodyTextStyle}" Margin="0,6,0,0"/><TextBlock Grid.Row="4" Text="连接" Style="{DynamicResource CaptionTextStyle}" Margin="0,6,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedApplication.ConnectionCount}" Style="{DynamicResource BodyTextStyle}" Margin="0,6,0,0"/></Grid>
                            <TextBlock Text="活动连接" Style="{DynamicResource SectionTitleStyle}" Margin="0,20,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedConnections}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,7"><StackPanel><TextBlock Text="{Binding Protocol}" Style="{DynamicResource BodyTextStyle}"/><TextBlock Text="{Binding LocalAddress, StringFormat=本地：{0}}" Style="{DynamicResource CaptionTextStyle}"/><TextBlock Text="{Binding RemoteAddress, StringFormat=远程：{0}}" Style="{DynamicResource CaptionTextStyle}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="8" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="网络接口实际流量" Style="{DynamicResource SectionTitleStyle}"/>
                    <TextBlock Text="接口统计独立于应用流量，不会与应用流量相加，避免 VPN 或本地代理造成重复计数。" Style="{DynamicResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                    <ItemsControl ItemsSource="{Binding Interfaces}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Style="{DynamicResource BodyTextStyle}"/><TextBlock Text="{Binding Type}" Style="{DynamicResource CaptionTextStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DownloadBytesPerSecond, StringFormat=↓ {0:N0} B/s}" Style="{DynamicResource BodyTextStyle}"/><TextBlock Grid.Column="2" Text="{Binding UploadBytesPerSecond, StringFormat=↑ {0:N0} B/s}" Style="{DynamicResource BodyTextStyle}"/><TextBlock Grid.Column="3" Text="{Binding PathKind}" Style="{DynamicResource CaptionTextStyle}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{Binding PrivacyText}" Style="{DynamicResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
